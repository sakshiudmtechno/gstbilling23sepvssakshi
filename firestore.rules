rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUserEmailAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'sakshi.udmtechno@gmail.com' ||
        request.auth.token.email == 'sankalpnayakk@gmail.com'
      );
    }

    // Allow access to application collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
