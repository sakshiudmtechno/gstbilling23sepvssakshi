# ==============================================================================
# UDM GST BILLING & CRM ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Network Configuration
# ------------------------------------------------------------------------------
# Port for the Node/Express backend (defaults to 3000 or process.env.PORT)
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Firebase / Google Cloud Project Identity
# ------------------------------------------------------------------------------
# Your Firebase Project ID
FIREBASE_PROJECT_ID=gen-lang-client-0486946771

# Firestore Database ID (use '(default)' or your custom database ID)
FIRESTORE_DATABASE_ID=ai-studio-gstbilling23sepv-ed65618f-66ed-4ea7-ba85-1e9daca7a455

# Web API Key for direct client/REST requests
FIREBASE_API_KEY=AIzaSyDC9f8sHINjenDyIWsqZBrb9d_NrA91A98

# ------------------------------------------------------------------------------
# 3. Firebase Admin SDK Authentication (Required for Production / Hostinger)
# ------------------------------------------------------------------------------
# OPTION A (Recommended for Hostinger VPS / Docker / Cloud Run):
# Paste the entire content of your Service Account JSON file as a single-line string.
# Example: {"type":"service_account","project_id":"...","private_key":"..."}
FIREBASE_SERVICE_ACCOUNT_KEY=

# OPTION B (Recommended for Hostinger VPS with local file storage):
# Absolute or relative file path to the downloaded service account JSON key file.
# Example: /etc/secrets/firebase-service-account.json or ./firebase-key.json
GOOGLE_APPLICATION_CREDENTIALS=

# Note: If neither FIREBASE_SERVICE_ACCOUNT_KEY nor GOOGLE_APPLICATION_CREDENTIALS
# is provided, the backend automatically uses the Firestore REST Engine with your
# project credentials and security rules (from firebase-applet-config.json).
# However, for highest performance and unlimited administrative operations on Hostinger,
# setting FIREBASE_SERVICE_ACCOUNT_KEY is recommended.

# ------------------------------------------------------------------------------
# 4. Frontend Client Environment Variables (Vite)
# ------------------------------------------------------------------------------
# Frontend client-accessible variables (must start with VITE_)
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0486946771
VITE_FIREBASE_API_KEY=AIzaSyDC9f8sHINjenDyIWsqZBrb9d_NrA91A98
VITE_FIREBASE_DATABASE_ID=ai-studio-gstbilling23sepv-ed65618f-66ed-4ea7-ba85-1e9daca7a455
